# ==============================================================================
# Print Studio Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your environment credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# --- Database Configuration (Neon PostgreSQL) ---
# Neon pooled connection string (with ?sslmode=require)
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct unpooled connection string (optional, for direct migrations/transactions)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_neon_password@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require"

# --- Hostname & Perimeter Security ---
# Production administrator dashboard domain (e.g. app.printstudio.ae or your-app.vercel.app)
APP_HOSTNAME="app.printstudio.ae"
# Public commercial storefront domain (e.g. printstudio.ae or www.printstudio.ae)
STORE_HOSTNAME="printstudio.ae"
# Optional apex domain for canonical 308 redirect to STORE_HOSTNAME
APEX_HOSTNAME="printstudio.ae"
# Optional storefront origin allowlist (e.g. https://printstudio.ae)
STORE_ORIGIN="https://printstudio.ae"

# --- Cloudflare R2 Storage (Dedicated Isolated Buckets) ---
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# Dedicated private CAD vault bucket (strictly confidential, customer 3D models)
R2_BUCKET_NAME="print-studio-cad-vault"
# Dedicated public media bucket (MUST NOT equal R2_BUCKET_NAME)
R2_PUBLIC_BUCKET_NAME="print-studio-public-media"
# Public CDN media domain (e.g. https://images.printstudio.ae)
R2_PUBLIC_DOMAIN="https://images.printstudio.ae"
NEXT_PUBLIC_MEDIA_DOMAIN="https://images.printstudio.ae"

# --- Bambu Lab Printer Integration ---
# Bambu Lab Cloud personal access token or JWT
BAMBU_TOKEN="your_bambu_cloud_token"
# Optional custom API base URL (defaults to official Bambu cloud endpoint)
BAMBU_API_BASE_URL="https://api.bambulab.com"

# --- Machine-to-Machine (M2M) Automation ---
# Precomputed SHA-256 hex digest of the bearer secret for /api/bambu/sync
BAMBU_M2M_SECRET_HASH="your_sha256_hash_of_m2m_bearer_token"
# Optional previous hash for zero-downtime key rotation
BAMBU_M2M_SECRET_HASH_PREVIOUS=""

# --- Initial Seed Administrator (Migration Only) ---
ADMIN_INITIAL_EMAIL="admin@printstudio.ae"
ADMIN_INITIAL_PASSWORD="your_secure_password_min_12_chars"
